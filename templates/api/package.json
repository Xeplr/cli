{
  "name": "@__NAME__/api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "__NAME__ backend \u2014 @xeplr/base-apis app.",
  "main": "app.js",
  "scripts": {
    "check-env": "dotenv -e development.env -- xeplr-check-env",
    "setup": "npm run db:create && npm run db:create:api && npm run migrate:auth",
    "db:encrypt": "xeplr encrypt",
    "db:create": "dotenv -e development.env -- xeplr-migrate create-db --connectionName auth --connection-env AUTH_DB_CONNECTION_INFO_ENCRYPTED --db-env AUTH_DB_NAME",
    "db:create:api": "dotenv -e development.env -- xeplr-migrate create-db --connectionName api --connection-env __PREFIX___CONNECTION --db-env DB_API",
    "migrate:auth": "dotenv -e development.env -- xeplr-auth-migrate up --connection-env AUTH_DB_CONNECTION_INFO_ENCRYPTED",
    "migrate:up": "dotenv -e development.env -- xeplr-migrate up --dir ./migrations --connectionName api --connection-env __PREFIX___CONNECTION",
    "start-auth": "dotenv -e ./development.env -- xeplr-auth-server",
    "start-api": "node ./bin/www"
  },
  "dependencies": {
    "@xeplr/auth": "^1.5.3",
    "@xeplr/base-apis": "^3.0.4",
    "@xeplr/db": "^1.1.0",
    "@xeplr/factory": "^3.0.3",
    "@xeplr/ui-factory": "^1.8.9",
    "@xeplr/utils": "^1.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.2",
    "@xeplr/actions": "^2.2.1",
    "@xeplr/workflow-api": "^2.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "@xeplr/cli": "^0.3.8"
  }
}
