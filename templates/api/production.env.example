# __NAME__ API — PRODUCTION settings. Copy to production.env on the server
# and fill in; start with NODE_ENV=production (bin/www and bin/workflow read
# <NODE_ENV>.env). production.env is never committed (.gitignore).
#
# Every value that is a secret is blank here. Generate new ones for production
# — never reuse development's.

NODE_ENV=production
LOG_DIR=./logs

# ── Ports: one per process on this server ──
__PREFIX___PORT=__API_PORT__
AUTH_PORT=__AUTH_PORT__
# Blank: workflow runs inside the API. Set: it runs as its own process
# (npm run start-workflow) and nginx sends /api/workflow to it.
WORKFLOW_PORT=

# ── Databases (same server, one login) ──
ENCRYPTION_KEY=
__PREFIX___CONNECTION=
AUTH_DB_CONNECTION_INFO_ENCRYPTED=
DB_API=__NAME___api
AUTH_DB_NAME=__NAME___auth

# ── Sign-in ──
REDIS_PREFIX=__NAME__:
AUTH_JWT_SECRET=
# Where THIS server reaches the sign-in service (not the public address).
AUTH_URL=http://127.0.0.1:__AUTH_PORT__
XEPLR_AUTH_MIGRATIONS=./node_modules/@xeplr/factory/migrations-auth,./migrations-auth,./node_modules/@xeplr/workflow/migrations-auth
AUTH_SUPER_ADMIN_EMAIL=
AUTH_SUPER_ADMIN_PASSWORD=

# ── Public addresses (what people's browsers open) ──
AUTH_ACTIVATION_URL=https://app.example.com/auth/activate
AUTH_INVITE_URL=https://app.example.com/auth/accept-invite

# ── Uploaded files — an absolute path on the server ──
FACTORY_FILES_DIR=/var/lib/__NAME__/uploads/factory
