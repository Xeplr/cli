{
  "expo": {
    "name": "__TITLE__",
    "slug": "__NAME__",
    "scheme": "__APP_SCHEME__",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "__APP_ID__" },
    "android": { "package": "__APP_ID__" },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      ["expo-camera", { "cameraPermission": "__TITLE__ uses the camera to take photos and read barcodes", "recordAudioAndroid": false, "barcodeScannerEnabled": true }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
